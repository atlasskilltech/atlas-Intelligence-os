# Copy to .env.local and fill in. Never commit .env.local.
# All values are read on the server only.

# --- AI provider (Milestone 2) ---
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_PLANNER_MODEL=

# --- Storage (Milestone 4) ---
DATA_DIR=./data

# --- Scheduling & webhooks (Milestone 9) ---
APP_TIMEZONE=Asia/Kolkata
WEBHOOK_SECRET=

# --- Connector network policy (Milestone 6) ---
# Comma-separated internal hostnames agents may reach, e.g. crm.example.edu.in
INTERNAL_ALLOWED_HOSTS=

# --- ATLAS internal connectors (Milestone 7) ---
ATLAS_CRM_BASE_URL=
ATLAS_CRM_API_KEY=

# --- Google (Gmail / Calendar, Milestone 8) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
