# Copy to .env.local and fill in. Never commit .env.local.
# All values are read on the server only.

# --- AI provider (Milestone 2) ---
OPENAI_API_KEY=
# Optional initial models (can be changed later in Model Settings).
# Defaults if empty: run model gpt-5.4-mini, planning model gpt-5.5
OPENAI_DEFAULT_MODEL=
OPENAI_PLANNER_MODEL=
# Optional: OpenAI-compatible endpoint (proxy/gateway). Leave empty for api.openai.com
OPENAI_BASE_URL=

# --- Storage (Milestone 4) ---
DATA_DIR=./data

# --- Scheduling & webhooks (Milestone 9) ---
APP_TIMEZONE=Asia/Kolkata
WEBHOOK_SECRET=

# --- Connector network policy (Milestone 6) ---
# Comma-separated hostnames that may resolve to private/internal addresses (and may use http://),
# e.g. crm.example.edu.in,10.0.0.12. Everything else must be public https.
INTERNAL_ALLOWED_HOSTS=

# --- Custom REST API secrets (Milestone 6) ---
# One env var per API key, named CONNECTOR_SECRET_<NAME>. On the Connectors page enter only the
# variable's NAME. For "basic" auth the value is user:password. Restart the app after changing.
# CONNECTOR_SECRET_HR_PORTAL=

# --- ATLAS internal connectors (Milestone 7) ---
ATLAS_CRM_BASE_URL=
ATLAS_CRM_API_KEY=

# --- Google (Gmail / Calendar, Milestone 8) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
