# Copy to .env.local and fill in. Never commit .env.local.
# All values are read on the server only.

# --- AI provider (Milestone 2) ---
OPENAI_API_KEY=
# Optional initial models (can be changed later in Model Settings).
# Defaults if empty: run model gpt-5.4-mini, planning model gpt-5.5
OPENAI_DEFAULT_MODEL=
OPENAI_PLANNER_MODEL=
# Optional: OpenAI-compatible endpoint (proxy/gateway). Leave empty for api.openai.com
OPENAI_BASE_URL=
# Voice Assistant (/voice): speech-to-text, text-to-speech model and default voice.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
# Optional: ElevenLabs text-to-speech. Choose OpenAI or ElevenLabs in Model Settings → Voice.
# If ElevenLabs fails (credits used up, key wrong) the reply is spoken with OpenAI instead.
ELEVENLABS_API_KEY=
# Optional: Voice ID and model are normally set in Model Settings → Voice assistant.
# These are only the starting values until they are saved there.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# --- Storage (Milestone 4) ---
DATA_DIR=./data

# --- Scheduler (Milestone 9) ---
# On an always-on server (EC2 + PM2) the scheduler starts by itself. Run ONE instance only.
# SCHEDULER_ENABLED=false turns it off for this process.
SCHEDULER_ENABLED=
# Hosts without an always-on process (Vercel): call GET /api/scheduler/tick every minute
# with header "Authorization: Bearer <CRON_SECRET>" (16+ characters).
CRON_SECRET=

# --- Connector network policy ---
# Comma-separated hostnames that may resolve to private/internal addresses (and may use http://),
# e.g. crm.example.edu.in,10.0.0.12. Everything else must be public https.
INTERNAL_ALLOWED_HOSTS=

# --- ATLAS project connections (Milestone 7) ---
# Master key that encrypts project keys entered on the Connectors page. Required to connect projects.
# Generate once: openssl rand -base64 32   (changing it later makes saved keys unreadable → replace them)
CONNECTOR_ENCRYPTION_KEY=

# --- Email — lets agents email their owner ---
# Option 1 (preferred): SMTP. For SendGrid over SMTP: host smtp.sendgrid.net, user apikey, pass = your API key.
# Port 587 = STARTTLS, 465 = TLS (or set SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=
# Option 2: SendGrid HTTP API ("Mail Send" permission). Used only when SMTP_HOST is empty.
SENDGRID_API_KEY=
# Default sender when a user has not set their own on the "Email sender" page.
# Empty = tech@atlasuniversity.edu.in. The mail server must allow sending from it
# (SendGrid: verify the sender or authenticate the atlasuniversity.edu.in domain).
SMTP_FROM=
SMTP_FROM_NAME=ATLAS IntelligenceOS
# Domains users may choose their own sender from (comma-separated). Empty = the default sender's domain.
EMAIL_ALLOWED_FROM_DOMAINS=

# --- Database (MySQL / MariaDB) — users ---
# Either DATABASE_URL=mysql://user:pass@host:3306/dbname  or the separate values below.
# Also accepted: MYSQL_HOST/MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE/MYSQL_PORT.
# Tables are created automatically and all start with intelligence_os_
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# DB_SSL=true

# --- Sign in with Google ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <your app URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of this app (recommended behind nginx/a load balancer), e.g. https://intelligence.example.edu.in
APP_URL=
# Optional: these emails are always admins. If empty, the first person to sign in becomes admin.
ADMIN_EMAILS=
# Optional: secret for login cookies. If empty, one is derived from CONNECTOR_ENCRYPTION_KEY.
AUTH_SECRET=

# Max characters of one tool result sent to the AI (default 24000, 4000–200000).
# Bigger results stay valid JSON: large lists are stored as datasets the agent
# reads in full with the built-in query_data tool.
# TOOL_RESULT_MAX_CHARS=24000

# --- ATLAS portal agent presets (optional, read at BUILD time, visible in the browser) ---
# Hosts for the Connect-form presets whose URL is not fixed (src/lib/portals/portalAgents.js).
# Empty → the preset shows a placeholder host the admin must replace. Full Agent API URL, e.g.
# https://learnx.example.edu/agent-api
NEXT_PUBLIC_ATLAS_LEARNX_AGENT_URL=
NEXT_PUBLIC_ATLAS_ADMISSIONS_AGENT_URL=
NEXT_PUBLIC_ATLAS_INTERNATIONAL_AGENT_URL=
